        <!-- Строка-кнопка (открывает панель) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                            <Grid>
                                <Canvas x:Name="RippleHost" ClipToBounds="True" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка под иконку в строке -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#1E2127"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Text2}"/>
        </Style>


        <!-- Цветные плитки иконок по смыслу -->
        <Style x:Key="TileGreen" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#242ED173"/><Setter Property="TextElement.Foreground" Value="#3FDC85"/>
        </Style>
        <Style x:Key="TileBlue" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#244C9BFF"/><Setter Property="TextElement.Foreground" Value="#6AAEFF"/>
        </Style>
        <Style x:Key="TileViolet" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#24A07CFF"/><Setter Property="TextElement.Foreground" Value="#B497FF"/>
        </Style>
        <Style x:Key="TileAmber" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#24F0B44A"/><Setter Property="TextElement.Foreground" Value="#F2C062"/>
        </Style>
        <Style x:Key="TileRose" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#24FF6B8A"/><Setter Property="TextElement.Foreground" Value="#FF7F98"/>
        </Style>
        <Style x:Key="TileCyan" TargetType="Border" BasedOn="{StaticResource IconTile}">
            <Setter Property="Background" Value="#2436D1D1"/><Setter Property="TextElement.Foreground" Value="#4FDADA"/>
        </Style>

        <Style x:Key="GhostIcon" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2127"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
