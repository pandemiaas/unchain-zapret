<UserControl x:Class="Unchain.Controls.CatBall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="36" IsHitTestVisible="False">
    <!-- Маскот: рыжий котик, свернувшийся клубком. Нарисован с нуля. -->
    <Viewbox>
        <Canvas Width="64" Height="48">
            <Canvas x:Name="Body" RenderTransformOrigin="0.5,0.8" Width="64" Height="48">
                <Canvas.RenderTransform><ScaleTransform x:Name="Breath"/></Canvas.RenderTransform>

                <!-- спинка -->
                <Ellipse Canvas.Left="16" Canvas.Top="10" Width="38" Height="36" Fill="#E9A25F"/>
                <Path Stroke="#D08440" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 40,13 C 45,16 48,20 48,25 M 48,29 C 49,33 48,36 45,39 M 33,11 C 37,13 39,16 40,19"/>
                <!-- хвост, обёрнутый вокруг -->
                <Path Stroke="#E09450" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 52,36 C 46,47 24,47 12,41"/>
                <Path Stroke="#C9783A" StrokeThickness="7" StrokeEndLineCap="Round" Data="M 15,42.5 L 12,41"/>
                <!-- голова -->
                <Path Fill="#F0AE6A" Data="M 10,25 L 8,13 L 17,19 Z M 23,19 L 28,9 L 31,21 Z"/>
                <Path Fill="#F6C9A0" Data="M 11,22 L 10,16 L 15,19.5 Z M 25,19 L 28,13 L 29.5,20 Z"/>
                <Ellipse Canvas.Left="7" Canvas.Top="17" Width="26" Height="24" Fill="#F0AE6A"/>
                <Path Stroke="#D08440" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 17,19.5 L 17,22.5 M 20,19 L 20,22.5 M 23,19.5 L 23,22.5"/>
                <!-- спящая мордочка -->
                <Path Stroke="#5A3A22" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 12.5,30 Q 15,32.5 17.5,30 M 22.5,30 Q 25,32.5 27.5,30"/>
                <Path Fill="#D9707A" Data="M 18.5,33 L 21.5,33 L 20,34.8 Z"/>
                <Ellipse Canvas.Left="10.5" Canvas.Top="33" Width="4" Height="2.4" Fill="#F2A3A0" Opacity="0.6"/>
                <Ellipse Canvas.Left="25.5" Canvas.Top="33" Width="4" Height="2.4" Fill="#F2A3A0" Opacity="0.6"/>
            </Canvas>
            <!-- z-z-z -->
            <TextBlock x:Name="Zzz" Text="z" Canvas.Left="34" Canvas.Top="-2" FontSize="11" FontWeight="Bold"
                       Foreground="#7C8494" Opacity="0">
                <TextBlock.RenderTransform><TranslateTransform x:Name="ZzzT"/></TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>
    </Viewbox>
</UserControl>
