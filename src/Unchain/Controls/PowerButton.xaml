<UserControl x:Class="Unchain.Controls.PowerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="156" Height="156" Cursor="Hand">
    <Grid>
        <!-- волны при включённом состоянии -->
        <Ellipse x:Name="Ring1" Width="132" Height="132" StrokeThickness="2" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke><SolidColorBrush x:Name="Ring1Brush" Color="#2ED173"/></Ellipse.Stroke>
            <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring2" Width="132" Height="132" StrokeThickness="2" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke><SolidColorBrush x:Name="Ring2Brush" Color="#2ED173"/></Ellipse.Stroke>
            <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale"/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- орбита: градиентное кольцо, крутится при подборе и медленно — когда включено -->
        <Ellipse x:Name="Orbit" Width="146" Height="146" StrokeThickness="2.5" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#002ED173" Offset="0"/>
                    <GradientStop Color="#002ED173" Offset="0.35"/>
                    <GradientStop Color="#FF2ED173" Offset="0.85"/>
                    <GradientStop Color="#FFB6F5CE" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRot"/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- мягкое свечение -->
        <Ellipse Width="156" Height="156" IsHitTestVisible="False" x:Name="Halo" Opacity="0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="HaloStop" Color="#30343C" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="Root" Width="124" Height="124" Background="Transparent" RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="OnDown" MouseLeftButtonUp="OnUp" MouseEnter="OnEnter" MouseLeave="OnLeave">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Ellipse>
                <Ellipse.Fill><SolidColorBrush x:Name="DiskBrush" Color="#262930"/></Ellipse.Fill>
            </Ellipse>
            <!-- объём: блик сверху, тень снизу -->
            <Ellipse IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#26000000" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Stroke="#24FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

            <Path x:Name="PowerIcon" IsHitTestVisible="False" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="44" Height="44" Stretch="Uniform"
                  Data="M 12,2 L 12,11 M 6.3,5.3 A 8.5,8.5 0 1 0 17.7,5.3">
                <Path.Stroke><SolidColorBrush x:Name="IconBrush" Color="#9AA1AE"/></Path.Stroke>
            </Path>

            <Path x:Name="Spinner" IsHitTestVisible="False" Visibility="Collapsed"
                  Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="46" Height="46" Stretch="None" RenderTransformOrigin="0.5,0.5"
                  Data="M 23,5 A 18,18 0 1 1 5,23">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinRot"/>
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Grid>
</UserControl>
